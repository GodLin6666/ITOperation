# ============================================================
# 环境变量示例文件
#
# 用法：复制本文件为 .env，改成你自己的值。
#   copy .env.example .env
#
# 注意：.env 已被 .gitignore 排除，不会提交进仓库。
# ============================================================

# MySQL root 密码（docker-compose.yml 会读取这个变量）
MYSQL_ROOT_PASSWORD=change-me-please

# 可选：如果你的 Ollama 不在宿主机默认端口，改这里
# OPSAI_OLLAMA_BASE_URL=http://host.docker.internal:11434
