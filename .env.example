# ============================================================
# 环境变量示例文件
#
# 用法：复制本文件为 .env，改成你自己的值。
#   copy .env.example .env
#
# 注意：.env 已被 .gitignore 排除，不会提交进仓库。
# ============================================================

# MySQL root 密码（docker-compose.yml 会读取这个变量）
MYSQL_ROOT_PASSWORD=change-me-please

# 可选：如果你的 Ollama 不在宿主机默认端口，改这里
# OPSAI_OLLAMA_BASE_URL=http://host.docker.internal:11434

# ============================================================
# 企业域（AD / LDAP）认证 —— 仅 docker-compose.prod.yml 使用
# 不填就是不启用，系统按本地账号登录
# ============================================================

# 认证模式：domain = 启用域认证（同时保留本地应急账号）；default = 纯本地账号
SPRING_PROFILES_ACTIVE=domain

# 域控地址（ldaps:// 更安全，需要配证书或设 OPSAI_LDAP_TRUST_ALL_CERTS=true）
OPSAI_LDAP_URL=ldap://dc01.corp.local:389

# 域的基础 DN
OPSAI_LDAP_BASE_DN=DC=corp,DC=local

# 用户查询过滤器：AD 用 (sAMAccountName={0})，OpenLDAP 用 (uid={0})
OPSAI_LDAP_USER_FILTER=(sAMAccountName={0})

# 只读服务账号：用来读用户的显示名和所属组（强烈建议配，否则可能读不到组）
OPSAI_LDAP_MANAGER_DN=CN=svc-opsai,OU=Service,DC=corp,DC=local
LDAP_MANAGER_PASSWORD=change-me-please

# 组 → 角色映射：memberOf 里包含这段文字就算命中（不区分大小写）
OPSAI_LDAP_ADMIN_GROUP=CN=OpsAI-Admins
OPSAI_LDAP_ENGINEER_GROUP=CN=OpsAI-Engineers

# 不属于任何授权组的域用户默认角色；想只放行指定组就设成空
OPSAI_LDAP_DEFAULT_ROLE=viewer

# Ollama 地址：同机用 host.docker.internal；独立 GPU 机器填它的内网 IP
OPSAI_OLLAMA_BASE_URL=http://host.docker.internal:11434

# 会话存储：memory（默认，单个后端）；redis（多台后端负载均衡时必须，否则会掉线）
OPSAI_AUTH_STORE=memory
